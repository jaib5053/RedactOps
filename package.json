{
  "name": "redactops",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "rm -f public/redactops-extension.zip && (cd extension && zip -r ../public/redactops-extension.zip manifest.json content.js popup.html icons/icon16.png icons/icon48.png icons/icon128.png)",
    "preview": "vite preview",
    "test": "node --import ./node_modules/jiti/lib/jiti-register.mjs --test tests/index.test.ts",
    "test:stress": "node --import ./node_modules/jiti/lib/jiti-register.mjs --test tests/stress-1000-prompts.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
